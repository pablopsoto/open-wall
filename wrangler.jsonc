{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-wall",
  "main": "worker/index.ts",
  // Served on the personal domain; the workers.dev address keeps working too.
  "workers_dev": true,
  "routes": [
    { "pattern": "open-wall.pablopsoto.dev", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only images and the API wake the Worker; pages and assets are served directly.
    "run_worker_first": ["/img/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-wall",
      "database_id": "01db8481-05e1-4d1d-b817-39e06166590d",
      "migrations_dir": "migrations"
    }
  ],
  // Slows down password guessing: a handful of login attempts per minute per address.
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
